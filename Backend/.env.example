NODE_ENV=development
PORT=5000

# Local: http://localhost:5173 | Deploy: apni Vercel/custom domain URL (aakhir me / nahi)
# Password reset ka link isi URL se banta hai.
FRONTEND_URL=http://localhost:5173

# Extra allowed origins, comma separated (custom domain ho to)
CORS_ORIGINS=

# Render/Railway ke peeche ho to 1 rakho
TRUST_PROXY=

MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d

# true = citizen submissions edit ke baad dobara admin approval maangengi
REQUIRE_ADMIN_APPROVAL=false

# Village identity (seed scripts / defaults)
VILLAGE_NAME=
VILLAGE_DISTRICT=
VILLAGE_STATE=
VILLAGE_PINCODE=
VILLAGE_MODEL_PATH=

# Cloudinary (image / resume upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Email (forgot password OTP, verification, notifications)
# Priority: BREVO_API_KEY (agar bhara ho)  ->  SMTP
# ---------------------------------------------------------------------------

# Option A (RECOMMENDED - Render/Railway par SMTP port block hota hai, ye HTTPS se chalta hai):
# brevo.com (free) -> Senders & IP me apna Gmail verify karo -> SMTP & API -> API Keys
BREVO_API_KEY=

# Option B (SMTP - local me theek, Render free par aksar block):
# HOST, USER, PASS teeno zaroori hain.
# SMTP_PASS = Google App Password (16 letter, bina space), normal Gmail password nahi.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Dono options me zaroori. Brevo use kar rahe ho to ye email Brevo me VERIFIED sender hona chahiye.
EMAIL_FROM="Smart Village <your-email@gmail.com>"

# AI assistant (optional). Key na ho to rule-based jawab chalte hain.
# Key ho to assistant "AI agent" mode me chalta hai (tools se live data khud dhoondhta hai).
ANTHROPIC_API_KEY=
# Khali = claude-haiku-4-5-20251001 (sasta). Zyada smart: claude-sonnet-5-5
ASSISTANT_MODEL=

# First admin seed (npm run seed:admin). Password khaali ho to random ban jayega.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=